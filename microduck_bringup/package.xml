<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>microduck_bringup</name>
  <version>0.1.0</version>
  <description>Launch files, parameters and RViz config for the Microduck ROS 2 simulation.</description>
  <maintainer email="projecthumanoidx@gmail.com">Arjun</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>microduck_sim</exec_depend>
  <exec_depend>microduck_policy</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>teleop_twist_joy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
